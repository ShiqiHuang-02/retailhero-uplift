    </dashboard>
    <dashboard name="03 人群与成本情景">
      <size maxheight="900" maxwidth="1200" minheight="900" minwidth="1200" sizing-mode="fixed" />
      <datasources>
        <datasource name="Parameters" />
      </datasources>
      <datasource-dependencies datasource="Parameters">
        <column name="[Margin]" caption="假设单客贡献毛利" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="30">
          <calculation class="tableau" formula="30" />
          <range min="0" max="1000" granularity=".1" />
        </column>
        <column name="[ContactCost]" caption="假设单次触达成本" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="0.5">
          <calculation class="tableau" formula="0.5" />
          <range min="0" max="1000" granularity=".1" />
        </column>
      </datasource-dependencies>
      <zones>
        <zone id="1" type-v2="text" x="2000" y="1000" w="96000" h="9000">
          <formatted-text>
            <run bold="true" fontsize="17">03 人群与成本情景｜RetailHero</run>
            <run fontsize="10">
离线估计；e=0.5 未核实；区间条件于固定模型。测试集此前已查看。</run>
          </formatted-text>
        </zone>
        <zone id="2" name="06 选中客户消费画像｜验证集" type-v2="viz" show-title="true" x="2000" y="17000" w="96000" h="33000" />
        <zone id="3" name="07 净收益情景｜假设金额·验证集" type-v2="viz" show-title="true" x="2000" y="51000" w="96000" h="33000" />
        <zone id="90" type-v2="paramctrl" param="[Parameters].[Margin]" x="2000" y="10000" w="46000" h="6000" />
        <zone id="91" type-v2="paramctrl" param="[Parameters].[ContactCost]" x="50000" y="10000" w="46000" h="6000" />
      </zones>
    </dashboard>
  </dashboards>
