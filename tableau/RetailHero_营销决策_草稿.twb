estimate_per_1000: &lt;[test_comparisons].[avg:estimate_per_1000:qk]&gt;
normal_ci_high: &lt;[test_comparisons].[avg:normal_ci_high:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[test_comparisons].[none:comparison:nk]</rows>
        <cols>[test_comparisons].[avg:normal_ci_low:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="04 触达比例曲线｜验证集探索">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">04 触达比例曲线｜验证集探索</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="contact_curve" caption="contact_curve" />
