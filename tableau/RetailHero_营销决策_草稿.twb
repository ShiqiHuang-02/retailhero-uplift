<?xml version='1.0' encoding='utf-8'?>
<workbook version="10.5" source-platform="mac" original-version="10.5" xmlns:user="http://www.tableausoftware.com/xml/user">
  <datasources>
    <datasource hasconnection="false" inline="true" name="Parameters" version="10.5">
      <column name="[Margin]" caption="假设单客贡献毛利" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="30">
        <calculation class="tableau" formula="30" />
        <range min="0" max="1000" granularity=".1" />
      </column>
      <column name="[ContactCost]" caption="假设单次触达成本" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="0.5">
        <calculation class="tableau" formula="0.5" />
        <range min="0" max="1000" granularity=".1" />
      </column>
    </datasource>
    <datasource caption="overall_rates" name="overall_rates" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="overall_rates.csv" server="" password="">
        <relation name="overall_rates.csv" table="[overall_rates#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="treatment_flg" datatype="integer" ordinal="0" />
            <column name="customers" datatype="integer" ordinal="1" />
            <column name="buyers" datatype="integer" ordinal="2" />
            <column name="purchase_rate" datatype="real" ordinal="3" />
          </columns>
        </relation>
      </connection>
      <column name="[treatment_flg]" datatype="integer" role="dimension" type="nominal" />
      <column name="[customers]" datatype="integer" role="measure" type="quantitative" />
      <column name="[buyers]" datatype="integer" role="measure" type="quantitative" />
      <column name="[purchase_rate]" datatype="real" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="test_policy" name="test_policy" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="test_policy.csv" server="" password="">
        <relation name="test_policy.csv" table="[test_policy#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="split" datatype="string" ordinal="0" />
            <column name="strategy" datatype="string" ordinal="1" />
            <column name="candidate_count" datatype="integer" ordinal="2" />
            <column name="contact_count" datatype="real" ordinal="3" />
            <column name="contacts_per_1000" datatype="real" ordinal="4" />
            <column name="gain_per_1000" datatype="real" ordinal="5" />
            <column name="se_per_1000" datatype="real" ordinal="6" />
            <column name="ci_low" datatype="real" ordinal="7" />
            <column name="ci_high" datatype="real" ordinal="8" />
          </columns>
        </relation>
      </connection>
      <column name="[split]" datatype="string" role="dimension" type="nominal" />
      <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
      <column name="[candidate_count]" datatype="integer" role="measure" type="quantitative" />
      <column name="[contact_count]" datatype="real" role="measure" type="quantitative" />
      <column name="[contacts_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[gain_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[se_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_low]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_high]" datatype="real" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="test_comparisons" name="test_comparisons" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="test_comparisons.csv" server="" password="">
        <relation name="test_comparisons.csv" table="[test_comparisons#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="split" datatype="string" ordinal="0" />
            <column name="comparison" datatype="string" ordinal="1" />
            <column name="estimate_per_1000" datatype="real" ordinal="2" />
            <column name="normal_ci_low" datatype="real" ordinal="3" />
            <column name="normal_ci_high" datatype="real" ordinal="4" />
            <column name="bootstrap_ci_low" datatype="real" ordinal="5" />
            <column name="bootstrap_ci_high" datatype="real" ordinal="6" />
            <column name="bootstrap_reps" datatype="integer" ordinal="7" />
            <column name="bootstrap_seed" datatype="integer" ordinal="8" />
            <column name="analysis_role" datatype="string" ordinal="9" />
            <column name="ci_width" datatype="real" ordinal="10" />
          </columns>
        </relation>
      </connection>
      <column name="[split]" datatype="string" role="dimension" type="nominal" />
      <column name="[comparison]" datatype="string" role="dimension" type="nominal" />
      <column name="[estimate_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[normal_ci_low]" datatype="real" role="measure" type="quantitative" />
      <column name="[normal_ci_high]" datatype="real" role="measure" type="quantitative" />
      <column name="[bootstrap_ci_low]" datatype="real" role="measure" type="quantitative" />
      <column name="[bootstrap_ci_high]" datatype="real" role="measure" type="quantitative" />
      <column name="[bootstrap_reps]" datatype="integer" role="measure" type="quantitative" />
      <column name="[bootstrap_seed]" datatype="integer" role="measure" type="quantitative" />
      <column name="[analysis_role]" datatype="string" role="dimension" type="nominal" />
      <column name="[ci_width]" datatype="real" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="contact_curve" name="contact_curve" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="contact_curve.csv" server="" password="">
        <relation name="contact_curve.csv" table="[contact_curve#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="split" datatype="string" ordinal="0" />
            <column name="strategy" datatype="string" ordinal="1" />
            <column name="contact_share" datatype="real" ordinal="2" />
            <column name="contacts_per_1000" datatype="real" ordinal="3" />
            <column name="gain_per_1000" datatype="real" ordinal="4" />
            <column name="ci_low" datatype="real" ordinal="5" />
            <column name="ci_high" datatype="real" ordinal="6" />
          </columns>
        </relation>
      </connection>
      <column name="[split]" datatype="string" role="dimension" type="nominal" />
      <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
      <column name="[contact_share]" datatype="real" role="dimension" type="quantitative" />
      <column name="[contacts_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[gain_per_1000]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_low]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_high]" datatype="real" role="measure" type="quantitative" />
      <column name="[net_value]" caption="假设净收益" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[gain_per_1000] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
      </column>
      <column name="[net_low]" caption="假设净收益下限" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[ci_low] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
      </column>
      <column name="[net_high]" caption="假设净收益上限" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[ci_high] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
      </column>
    </datasource>
    <datasource caption="uplift_calibration" name="uplift_calibration" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="uplift_calibration.csv" server="" password="">
        <relation name="uplift_calibration.csv" table="[uplift_calibration#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="uplift_group" datatype="string" ordinal="0" />
            <column name="customers" datatype="integer" ordinal="1" />
            <column name="predicted_uplift_pp" datatype="real" ordinal="2" />
            <column name="estimated_uplift_pp" datatype="real" ordinal="3" />
            <column name="ci_low_pp" datatype="real" ordinal="4" />
            <column name="ci_high_pp" datatype="real" ordinal="5" />
          </columns>
        </relation>
      </connection>
      <column name="[uplift_group]" datatype="string" role="dimension" type="nominal" />
      <column name="[customers]" datatype="integer" role="measure" type="quantitative" />
      <column name="[predicted_uplift_pp]" datatype="real" role="measure" type="quantitative" />
      <column name="[estimated_uplift_pp]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_low_pp]" datatype="real" role="measure" type="quantitative" />
      <column name="[ci_high_pp]" datatype="real" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="validation_profiles" name="validation_profiles" inline="true" version="10.5">
      <connection class="textscan" directory="data" filename="validation_profiles.csv" server="" password="">
        <relation name="validation_profiles.csv" table="[validation_profiles#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column name="split" datatype="string" ordinal="0" />
            <column name="strategy" datatype="string" ordinal="1" />
            <column name="expected_contacts" datatype="real" ordinal="2" />
            <column name="mean_recency_days" datatype="real" ordinal="3" />
            <column name="mean_history_transactions" datatype="real" ordinal="4" />
            <column name="mean_history_spend" datatype="real" ordinal="5" />
            <column name="mean_response_score" datatype="real" ordinal="6" />
            <column name="mean_predicted_uplift" datatype="real" ordinal="7" />
          </columns>
        </relation>
      </connection>
      <column name="[split]" datatype="string" role="dimension" type="nominal" />
      <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
      <column name="[expected_contacts]" datatype="real" role="measure" type="quantitative" />
      <column name="[mean_recency_days]" datatype="real" role="measure" type="quantitative" />
      <column name="[mean_history_transactions]" datatype="real" role="measure" type="quantitative" />
      <column name="[mean_history_spend]" datatype="real" role="measure" type="quantitative" />
      <column name="[mean_response_score]" datatype="real" role="measure" type="quantitative" />
      <column name="[mean_predicted_uplift]" datatype="real" role="measure" type="quantitative" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="01 两组购买率｜全样本描述">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">01 两组购买率｜全样本描述</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="overall_rates" caption="overall_rates" />
          </datasources>
          <datasource-dependencies datasource="overall_rates">
            <column name="[treatment_flg]" datatype="integer" role="dimension" type="nominal" />
            <column-instance column="[treatment_flg]" derivation="None" name="[none:treatment_flg:nk]" pivot="key" type="nominal" />
            <column name="[purchase_rate]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[purchase_rate]" derivation="Avg" name="[avg:purchase_rate:qk]" pivot="key" type="quantitative" />
            <column name="[customers]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[customers]" derivation="Avg" name="[avg:customers:qk]" pivot="key" type="quantitative" />
            <column name="[buyers]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[buyers]" derivation="Avg" name="[avg:buyers:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Bar" />
            <encodings>
              <lod column="[overall_rates].[avg:customers:qk]" />
              <lod column="[overall_rates].[avg:buyers:qk]" />
            </encodings>
            <customized-tooltip show-command-buttons="false">
              <formatted-text>
                <run>treatment_flg: &lt;[overall_rates].[none:treatment_flg:nk]&gt;
purchase_rate: &lt;[overall_rates].[avg:purchase_rate:qk]&gt;
customers: &lt;[overall_rates].[avg:customers:qk]&gt;
buyers: &lt;[overall_rates].[avg:buyers:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[overall_rates].[none:treatment_flg:nk]</rows>
        <cols>[overall_rates].[avg:purchase_rate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="02 策略收益｜既有测试集·20%触达">
      <layout-options>
        <title>
