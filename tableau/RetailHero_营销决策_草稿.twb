ci_high: &lt;[test_policy].[avg:ci_high:qk]&gt;
contacts_per_1000: &lt;[test_policy].[avg:contacts_per_1000:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[test_policy].[none:strategy:nk]</rows>
        <cols>[test_policy].[avg:gain_per_1000:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="03 策略差异95%区间｜既有测试集">
      <layout-options>
