          <datasource-dependencies datasource="contact_curve">
            <column name="[gain_per_1000]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[gain_per_1000]" derivation="Avg" name="[avg:gain_per_1000:qk]" pivot="key" type="quantitative" />
            <column name="[contact_share]" datatype="real" role="dimension" type="quantitative" />
            <column-instance column="[contact_share]" derivation="None" name="[none:contact_share:qk]" pivot="key" type="quantitative" />
            <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
