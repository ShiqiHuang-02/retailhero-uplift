    <worksheet name="05 分组DR效果｜验证集">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">05 分组DR效果｜验证集</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="uplift_calibration" caption="uplift_calibration" />
          </datasources>
          <datasource-dependencies datasource="uplift_calibration">
            <column name="[uplift_group]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[uplift_group]" derivation="None" name="[none:uplift_group:nk]" pivot="key" type="nominal" />
            <column name="[estimated_uplift_pp]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[estimated_uplift_pp]" derivation="Avg" name="[avg:estimated_uplift_pp:qk]" pivot="key" type="quantitative" />
            <column name="[predicted_uplift_pp]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[predicted_uplift_pp]" derivation="Avg" name="[avg:predicted_uplift_pp:qk]" pivot="key" type="quantitative" />
            <column name="[ci_low_pp]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[ci_low_pp]" derivation="Avg" name="[avg:ci_low_pp:qk]" pivot="key" type="quantitative" />
            <column name="[ci_high_pp]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[ci_high_pp]" derivation="Avg" name="[avg:ci_high_pp:qk]" pivot="key" type="quantitative" />
            <column name="[customers]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[customers]" derivation="Avg" name="[avg:customers:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Bar" />
            <encodings>
              <lod column="[uplift_calibration].[avg:predicted_uplift_pp:qk]" />
              <lod column="[uplift_calibration].[avg:ci_low_pp:qk]" />
              <lod column="[uplift_calibration].[avg:ci_high_pp:qk]" />
              <lod column="[uplift_calibration].[avg:customers:qk]" />
            </encodings>
            <customized-tooltip show-command-buttons="false">
              <formatted-text>
                <run>uplift_group: &lt;[uplift_calibration].[none:uplift_group:nk]&gt;
estimated_uplift_pp: &lt;[uplift_calibration].[avg:estimated_uplift_pp:qk]&gt;
predicted_uplift_pp: &lt;[uplift_calibration].[avg:predicted_uplift_pp:qk]&gt;
ci_low_pp: &lt;[uplift_calibration].[avg:ci_low_pp:qk]&gt;
ci_high_pp: &lt;[uplift_calibration].[avg:ci_high_pp:qk]&gt;
customers: &lt;[uplift_calibration].[avg:customers:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[uplift_calibration].[none:uplift_group:nk]</rows>
        <cols>[uplift_calibration].[avg:estimated_uplift_pp:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="06 选中客户消费画像｜验证集">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">06 选中客户消费画像｜验证集</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="validation_profiles" caption="validation_profiles" />
          </datasources>
          <datasource-dependencies datasource="validation_profiles">
            <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[strategy]" derivation="None" name="[none:strategy:nk]" pivot="key" type="nominal" />
            <column name="[mean_history_spend]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[mean_history_spend]" derivation="Avg" name="[avg:mean_history_spend:qk]" pivot="key" type="quantitative" />
            <column name="[mean_recency_days]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[mean_recency_days]" derivation="Avg" name="[avg:mean_recency_days:qk]" pivot="key" type="quantitative" />
            <column name="[mean_history_transactions]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[mean_history_transactions]" derivation="Avg" name="[avg:mean_history_transactions:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Bar" />
            <encodings>
              <lod column="[validation_profiles].[avg:mean_recency_days:qk]" />
              <lod column="[validation_profiles].[avg:mean_history_transactions:qk]" />
            </encodings>
            <customized-tooltip show-command-buttons="false">
              <formatted-text>
                <run>strategy: &lt;[validation_profiles].[none:strategy:nk]&gt;
mean_history_spend: &lt;[validation_profiles].[avg:mean_history_spend:qk]&gt;
mean_recency_days: &lt;[validation_profiles].[avg:mean_recency_days:qk]&gt;
mean_history_transactions: &lt;[validation_profiles].[avg:mean_history_transactions:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[validation_profiles].[none:strategy:nk]</rows>
        <cols>[validation_profiles].[avg:mean_history_spend:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="07 净收益情景｜假设金额·验证集">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">07 净收益情景｜假设金额·验证集</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="contact_curve" caption="contact_curve" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="contact_curve">
            <column name="[net_value]" caption="假设净收益" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="[gain_per_1000] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
            </column>
            <column-instance column="[net_value]" derivation="Avg" name="[avg:net_value:qk]" pivot="key" type="quantitative" />
            <column name="[contact_share]" datatype="real" role="dimension" type="quantitative" />
            <column-instance column="[contact_share]" derivation="None" name="[none:contact_share:qk]" pivot="key" type="quantitative" />
            <column name="[strategy]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[strategy]" derivation="None" name="[none:strategy:nk]" pivot="key" type="nominal" />
            <column name="[net_low]" caption="假设净收益下限" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="[ci_low] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
            </column>
            <column-instance column="[net_low]" derivation="Avg" name="[avg:net_low:qk]" pivot="key" type="quantitative" />
            <column name="[net_high]" caption="假设净收益上限" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="[ci_high] * [Parameters].[Margin] - [contacts_per_1000] * [Parameters].[ContactCost]" />
            </column>
            <column-instance column="[net_high]" derivation="Avg" name="[avg:net_high:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column name="[Margin]" caption="假设单客贡献毛利" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="30">
              <calculation class="tableau" formula="30" />
              <range min="0" max="1000" granularity=".1" />
            </column>
            <column name="[ContactCost]" caption="假设单次触达成本" datatype="real" role="measure" type="quantitative" param-domain-type="range" value="0.5">
              <calculation class="tableau" formula="0.5" />
              <range min="0" max="1000" granularity=".1" />
            </column>
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Line" />
            <encodings>
              <color column="[contact_curve].[none:strategy:nk]" />
              <lod column="[contact_curve].[avg:net_low:qk]" />
              <lod column="[contact_curve].[avg:net_high:qk]" />
            </encodings>
            <customized-tooltip show-command-buttons="false">
              <formatted-text>
                <run>net_value: &lt;[contact_curve].[avg:net_value:qk]&gt;
contact_share: &lt;[contact_curve].[none:contact_share:qk]&gt;
strategy: &lt;[contact_curve].[none:strategy:nk]&gt;
net_low: &lt;[contact_curve].[avg:net_low:qk]&gt;
net_high: &lt;[contact_curve].[avg:net_high:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[contact_curve].[avg:net_value:qk]</rows>
        <cols>[contact_curve].[none:contact_share:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="01 营销效果概览">
