            <column name="[estimate_per_1000]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[estimate_per_1000]" derivation="Avg" name="[avg:estimate_per_1000:qk]" pivot="key" type="quantitative" />
            <column name="[normal_ci_high]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[normal_ci_high]" derivation="Avg" name="[avg:normal_ci_high:qk]" pivot="key" type="quantitative" />
